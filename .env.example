PORT=3000

# Cadena de conexion de Supabase (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:6543/postgres

# Clave secreta para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta

# Tiempo de expiracion del token
JWT_EXPIRES_IN=2h
